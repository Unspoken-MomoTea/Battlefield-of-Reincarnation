{
  "name": "reincarnation-workshop-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "update": "node scripts/update-servers.mjs",
    "update:staging": "node scripts/update-servers.mjs staging",
    "update:production": "node scripts/update-servers.mjs production",
    "update:both": "node scripts/update-servers.mjs both",
    "test": "node --test",
    "dev": "npx wrangler dev",
    "deploy": "npm run deploy:staging",
    "db:migrate:local": "npx wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "node -e \"console.error('请选择 db:migrate:staging 或 db:migrate:production，拒绝使用含糊的 remote 环境。'); process.exit(1)\"",
    "db:migrate:staging": "npx wrangler d1 migrations apply DB --env staging --remote",
    "deploy:staging": "npx wrangler deploy --env staging",
    "deploy:production": "node scripts/production-command.mjs deploy",
    "db:migrate:production": "node scripts/production-command.mjs migrate"
  },
  "devDependencies": {
    "wrangler": "^4.131.1"
  }
}
