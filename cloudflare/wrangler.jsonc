{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reincarnation-workshop",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,

  "vars": {
    "PUBLIC_BASE_URL": "https://workshop.6661816.xyz",
    "DISCORD_CLIENT_ID": "1551049511915491348",
    "SESSION_TTL_SECONDS": "2592000",
    "ADMIN_DISCORD_IDS": "1292524256764231700",
    "CLIENT_UPDATE_CHANNEL": "stable",
    "CLIENT_UPDATE_REF": "workshop-stable",
    "OPENING_UPDATE_CHANNEL": "testing",
    "OPENING_UPDATE_REF": "main",
    "STATUS_BAR_UPDATE_CHANNEL": "stable",
    "STATUS_BAR_UPDATE_REF": "status-bar-v*",
    "CALCULATOR_UPDATE_CHANNEL": "stable",
    "CALCULATOR_UPDATE_REF": "calculator-v*"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reincarnation_workshop_staging",
      "database_id": "d3061236-6338-456d-abed-736d638e0fbd"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "SESSION_KV",
      "id": "7f1a9aea395d46748b58ff368386e1a8"
    }
  ],

  "r2_buckets": [
    {
      "binding": "PROJECTS",
      "bucket_name": "reincarnation-workshop-projects-staging"
    }
  ],
  "env": {
    "staging": {
      "name": "reincarnation-workshop-staging",
      "triggers": {
        "crons": ["0 * * * *"]
      },
      "routes": [
        {
          "pattern": "workshop-test.6661816.xyz",
          "custom_domain": true
        }
      ],
      "vars": {
        "PUBLIC_BASE_URL": "https://workshop-test.6661816.xyz",
        "DISCORD_CLIENT_ID": "1551049511915491348",
        "SESSION_TTL_SECONDS": "2592000",
        "ADMIN_DISCORD_IDS": "1292524256764231700",
        "CLIENT_UPDATE_CHANNEL": "testing",
        "CLIENT_UPDATE_REF": "main",
        "OPENING_UPDATE_CHANNEL": "testing",
        "OPENING_UPDATE_REF": "main",
        "STATUS_BAR_UPDATE_CHANNEL": "stable",
        "STATUS_BAR_UPDATE_REF": "status-bar-v*",
    "CALCULATOR_UPDATE_CHANNEL": "stable",
    "CALCULATOR_UPDATE_REF": "calculator-v*"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "reincarnation_workshop_staging",
          "database_id": "d3061236-6338-456d-abed-736d638e0fbd"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "SESSION_KV",
          "id": "7f1a9aea395d46748b58ff368386e1a8"
        }
      ],
      "r2_buckets": [
        {
          "binding": "PROJECTS",
          "bucket_name": "reincarnation-workshop-projects-staging"
        }
      ]
    },
    "production": {
      "name": "reincarnation-workshop-production",
      "routes": [
        {
          "pattern": "workshop.6661816.xyz",
          "custom_domain": true
        }
      ],
      "vars": {
        "PUBLIC_BASE_URL": "https://workshop.6661816.xyz",
        "DISCORD_CLIENT_ID": "1551049511915491348",
        "SESSION_TTL_SECONDS": "2592000",
        "ADMIN_DISCORD_IDS": "1292524256764231700",
        "CLIENT_UPDATE_CHANNEL": "stable",
        "CLIENT_UPDATE_REF": "workshop-stable",
        "OPENING_UPDATE_CHANNEL": "testing",
        "OPENING_UPDATE_REF": "main",
        "STATUS_BAR_UPDATE_CHANNEL": "stable",
        "STATUS_BAR_UPDATE_REF": "status-bar-v*",
    "CALCULATOR_UPDATE_CHANNEL": "stable",
    "CALCULATOR_UPDATE_REF": "calculator-v*"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "reincarnation_workshop_staging",
          "database_id": "d3061236-6338-456d-abed-736d638e0fbd"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "SESSION_KV",
          "id": "7f1a9aea395d46748b58ff368386e1a8"
        }
      ],
      "r2_buckets": [
        {
          "binding": "PROJECTS",
          "bucket_name": "reincarnation-workshop-projects-staging"
        }
      ]
    }
  }
}
